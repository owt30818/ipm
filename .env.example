# =============================================================
# Supabase Cloud (https://supabase.com/dashboard)
# 모두 런타임 env로 읽음 (빌드 시 불필요). 로컬 개발에서는 NEXT_PUBLIC_* 이름도 동작
# =============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# =============================================================
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# =============================================================
# Cloudflare Tunnel (https://one.dash.cloudflare.com → Tunnels)
# 터널 생성 후 "Install connector" 에서 토큰 복사
# =============================================================
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# =============================================================
# Local Dev only (docker-compose.dev.yml)
# =============================================================
POSTGRES_USER=ipam
POSTGRES_PASSWORD=ipam_secret
POSTGRES_DB=ipam
