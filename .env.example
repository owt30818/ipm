# =============================================================
# Supabase Cloud (https://supabase.com/dashboard)
# 모두 런타임 env로 읽음 (빌드 시 불필요). 로컬 개발에서는 NEXT_PUBLIC_* 이름도 동작
# =============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# =============================================================
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# =============================================================
# Cloudflare Tunnel (https://one.dash.cloudflare.com → Tunnels)
# 터널 생성 후 "Install connector" 에서 토큰 복사
# =============================================================
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# =============================================================
# DB 백업 (docker-compose.yml 의 db-backup 서비스)
# 대시보드 → Connect → "Session pooler" 값 사용 (Direct 연결은 IPv6 전용이라 Docker에서 실패)
# Transaction pooler(6543)는 pg_dump 불가
# =============================================================
BACKUP_PGHOST=aws-0-ap-northeast-2.pooler.supabase.com
BACKUP_PGPORT=5432
BACKUP_PGUSER=postgres.your-project-ref
BACKUP_PGPASSWORD=your-database-password
# TrueNAS: /mnt/<pool>/<dataset>/ipam-backups (스냅샷/복제 대상 데이터셋 권장)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# =============================================================
# Local Dev only (docker-compose.dev.yml)
# =============================================================
POSTGRES_USER=ipam
POSTGRES_PASSWORD=ipam_secret
POSTGRES_DB=ipam
